// KRATINGDAENG HOMECOMING ACTIVATION 2027 — Apps Script API
const CONFIG={SPREADSHEET_ID:"PASTE_GOOGLE_SHEET_ID_HERE",TOKEN_TTL_HOURS:12,LOCATION_STALE_MINUTES:30};
const SHEETS={Users_Access:["userId","username","passwordHash","name","role","venueId","teamId","active","createdAt"],Master_Booths:["venueId","venueName","type","target","active"],Sessions:["token","userId","expiresAt"],Locations_Log:["userId","name","role","venueId","teamId","lat","lng","accuracy","updatedAt"],Visitors_Log:["timestamp","userId","venueId","metric","delta"],Sales_Sampling:["timestamp","userId","venueId","type","sku","qty","amount","notes"],Inventory_Opname:["timestamp","userId","venueId","sku","opening","in","out","closing","notes"],Drive_Docs:["timestamp","userId","venueId","fileName","mimeType","driveFileId","url"]};
function doGet(){return out_({ok:true,service:"Kratingdaeng Activation API",version:"1.0.0"})}
function doPost(e){try{const b=JSON.parse(e.postData.contents||"{}");return out_({ok:true,data:route_(b)})}catch(x){return out_({ok:false,error:String(x.message||x)})}}
function route_(b){switch(b.action){case"login":return login_(b.username,b.password);case"dashboard":return dashboard_(auth_(b.token));case"locationPing":return ping_(auth_(b.token),b);case"visitorClick":return click_(auth_(b.token),b);case"health":return{status:"ok"};default:throw Error("Action tidak dikenal: "+b.action)}}
function setupDatabase(){const ss=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);Object.keys(SHEETS).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(!s.getLastRow())s.appendRow(SHEETS[n])})}
function login_(username,password){if(!username||!password)throw Error("Username dan password wajib diisi");const a=tab_("Users_Access").getDataRange().getValues(),h=a.shift(),i=idx_(h);const u=a.find(r=>String(r[i.username]).toLowerCase()===String(username).toLowerCase()&&String(r[i.active]).toLowerCase()!=="false");if(!u||String(u[i.passwordHash])!==hash_(String(password)))throw Error("Username atau password salah");const token=Utilities.getUuid()+Utilities.getUuid(),expires=new Date(Date.now()+CONFIG.TOKEN_TTL_HOURS*3600000).toISOString();tab_("Sessions").appendRow([token,u[i.userId],expires]);return{user:{userId:u[i.userId],name:u[i.name],role:u[i.role],venueId:u[i.venueId],teamId:u[i.teamId],token}}}
function auth_(token){if(!token)throw Error("Sesi tidak ditemukan");const a=tab_("Sessions").getDataRange().getValues(),h=a.shift(),i=idx_(h),s=a.find(r=>String(r[i.token])===String(token)&&new Date(r[i.expiresAt]).getTime()>Date.now());if(!s)throw Error("Sesi kedaluwarsa");const u=tab_("Users_Access").getDataRange().getValues(),uh=u.shift(),j=idx_(uh),r=u.find(x=>String(x[j.userId])===String(s[i.userId]));if(!r)throw Error("Akun tidak ditemukan");return{userId:r[j.userId],name:r[j.name],role:r[j.role],venueId:r[j.venueId],teamId:r[j.teamId]}}
function ping_(u,b){if(!["TL","SPG","CREW"].includes(u.role))throw Error("Role tidak mengirim lokasi");const lat=Number(b.lat),lng=Number(b.lng);if(!isFinite(lat)||!isFinite(lng)||Math.abs(lat)>90||Math.abs(lng)>180)throw Error("Koordinat tidak valid");tab_("Locations_Log").appendRow([u.userId,u.name,u.role,u.venueId,u.teamId,lat,lng,Number(b.accuracy||0),new Date().toISOString()]);return{saved:true}}
function click_(u,b){if(!["ADMIN","CLIENT","TL","SPG"].includes(u.role))throw Error("Akses clicker ditolak");const venue=String(b.venueId||u.venueId),metric=String(b.metric||"VISITOR"),delta=Number(b.delta);if(!["ADMIN","CLIENT"].includes(u.role)&&venue!==String(u.venueId))throw Error("Akses venue ditolak");if(!["VISITOR","UNIQUE_MIRROR","PHOTO_BOOTH"].includes(metric)||![1,-1].includes(delta))throw Error("Input tidak valid");const s=tab_("Visitors_Log");s.appendRow([new Date().toISOString(),u.userId,venue,metric,delta]);const a=s.getDataRange().getValues();a.shift();return{total:a.filter(r=>String(r[2])===venue&&String(r[3])===metric).reduce((n,r)=>n+Number(r[4]||0),0),delta}}
function dashboard_(u){const a=tab_("Locations_Log").getDataRange().getValues(),h=a.shift(),i=idx_(h),latest={};a.forEach(r=>{const k=String(r[i.userId]);if(!latest[k]||new Date(r[i.updatedAt])>new Date(latest[k][i.updatedAt]))latest[k]=r});let locations=Object.keys(latest).map(k=>{const r=latest[k];return{userId:r[i.userId],name:r[i.name],role:r[i.role],venueId:r[i.venueId],teamId:r[i.teamId],lat:Number(r[i.lat]),lng:Number(r[i.lng]),accuracy:Number(r[i.accuracy]),updatedAt:r[i.updatedAt]}}).filter(p=>Date.now()-new Date(p.updatedAt).getTime()<=CONFIG.LOCATION_STALE_MINUTES*60000);if(u.role==="TL")locations=locations.filter(p=>String(p.teamId)===String(u.teamId));else if(!["ADMIN","CLIENT"].includes(u.role))locations=locations.filter(p=>p.userId===u.userId);const v=tab_("Visitors_Log").getDataRange().getValues();v.shift();const sales=tab_("Sales_Sampling").getDataRange().getValues();sales.shift();const b=tab_("Master_Booths").getDataRange().getValues();b.shift();const venues=["ADMIN","CLIENT"].includes(u.role)?b:b.filter(r=>String(r[0])===String(u.venueId));return{totals:{visitors:v.reduce((n,r)=>n+Number(r[4]||0),0),sales:sales.reduce((n,r)=>n+Number(r[6]||0),0),sampling:sales.filter(r=>r[3]==="SAMPLING").reduce((n,r)=>n+Number(r[5]||0),0),activePersonnel:locations.length},venues:venues.map(r=>({venueId:r[0],venueName:r[1],type:r[2],target:Number(r[3]||0)})),locations}}
function tab_(n){const s=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID).getSheetByName(n);if(!s)throw Error("Sheet belum ada: "+n+"; jalankan setupDatabase()");return s}function idx_(h){const o={};h.forEach((x,i)=>o[String(x)]=i);return o}function hash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(b=>(b+256).toString(16).slice(-2)).join("")}function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
